# ============================================================
# SWARM AI — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# Leave unset to use the default local SQLite database at instance/swarmai.db
# (relative to the project root — Flask will resolve this correctly).
# DATABASE_URL=sqlite:////absolute/path/to/instance/swarmai.db
# Production (PostgreSQL), example:
# DATABASE_URL=postgresql://user:password@localhost:5432/swarmai

# Admin bootstrap (used only by `flask seed-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# License API signing
# Used to HMAC-sign license validation responses so an EA can verify
# a reply genuinely came from this server (see app/services/license_service.py)
LICENSE_HMAC_SECRET=change-this-to-a-long-random-string

# License validation API - simple per-key rate limit
LICENSE_API_RATE_LIMIT_PER_HOUR=30

# Site
SITE_NAME=Swarm AI
SITE_DOMAIN=example.com
SUPPORT_EMAIL=support@example.com
# Admin's Telegram contact for manual purchases/support — buyers message this
# to pay and receive their license key. Leave blank to hide the Telegram CTA.
SUPPORT_TELEGRAM_URL=https://t.me/your_admin_handle

# Mail (optional — required for password reset emails in production)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
